# À copier sous le nom ".env" à la racine du clone de 3liz/lizmap-docker-compose.
# docker compose le lit automatiquement.

LIZMAP_VERSION_TAG=3.9
# Version de QGIS Server : égale ou supérieure à celle de QGIS Desktop.
QGIS_VERSION_TAG=3.44
QGIS_MAP_WORKERS=2

LIZMAP_UID=1000
LIZMAP_GID=1000
LIZMAP_DIR=./lizmap
LIZMAP_PROJECTS=./lizmap/instances

# Accessibles uniquement depuis ce PC
LIZMAP_PORT=127.0.0.1:8090
OWS_PORT=127.0.0.1:8091

# Service "postgis" du dépôt officiel : désactivé par docker-compose.override.yml.
# Ces valeurs ne servent qu'à garder le fichier compose valide.
POSTGIS_VERSION=17-3
POSTGIS_PORT=127.0.0.1:8093
POSTGIS_ALIAS=db.lizmap
POSTGRES_PASSWORD=inutilise
POSTGRES_LIZMAP_DB=lizmap
POSTGRES_LIZMAP_USER=lizmap
POSTGRES_LIZMAP_PASSWORD=inutilise
